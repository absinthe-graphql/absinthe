# Track the committed benchmark suite (scripts + README) but keep any local
# scratch output under bench/ ignored.
/bench/*
!/bench/*.exs
!/bench/README.md
/_build
/cover
/deps
/doc
/.elixir_ls
erl_crash.dump
*.ez
src/*.erl
.tool-versions*
missing_rules.rb
.DS_Store
/priv/plts/*.plt
/priv/plts/*.plt.hash
/tmp
mise.toml
.expert